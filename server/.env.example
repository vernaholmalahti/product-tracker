# Copy this file to .env and fill in real values:
#   cp .env.example .env
# .env is git-ignored. Never commit real keys.

# Port the API listens on
PORT=4000

# PostgreSQL connection string (used from Phase 1, Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/noveltrack"

# Anthropic API key (used from Phase 6, worker only – never in the mobile app)
ANTHROPIC_API_KEY="sk-ant-your-key-here"
