# Copy this file to .env and fill in real values:
#   cp .env.example .env
# .env is git-ignored. Never commit real keys.

# Port the API listens on
PORT=4000

# PostgreSQL connection string (Prisma). Matches docker-compose.yml – start it with: docker compose up -d
DATABASE_URL="postgresql://ripe:ripe@localhost:5432/ripe"

# Anthropic API key (used from Phase 6, worker only – never in the mobile app)
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# Claude model the worker uses (Phase 6)
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Max AI calls per worker run – cost limit, ground rule 6 (Phase 6)
AI_MAX_CALLS_PER_RUN=10

# Cost saver: a full AI check per product every N days; in between, Claude is only asked
# when one of the product's official pages changed (Phase 6)
AI_FULL_CHECK_DAYS=7

# Secret token for the admin routes (Phase 4). Use a long random string in production.
ADMIN_TOKEN="change-me"

# When the daily worker runs, cron format: minute hour day month weekday (Phase 5). 6:00 every day:
WORKER_CRON="0 6 * * *"

# Time zone for WORKER_CRON (IANA name). Hosting servers usually run in UTC, so set it explicitly.
WORKER_TIMEZONE="Europe/Helsinki"
