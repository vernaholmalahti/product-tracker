{
  "name": "ripe-server",
  "version": "1.0.0",
  "description": "Ripe API and update worker",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "notify:status": "tsx scripts/notifyStatus.ts",
    "pending:fake": "tsx scripts/fakePending.ts",
    "test-data:clean": "tsx scripts/cleanTestData.ts",
    "worker": "tsx src/worker/index.ts",
    "worker:daily": "tsx src/worker/index.ts --daily",
    "ai:check": "tsx scripts/aiCheck.ts",
    "ai:test": "tsx scripts/aiTestProduct.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "ai:fake-run": "tsx scripts/fakeAiRun.ts"
  },
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "node-cron": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
