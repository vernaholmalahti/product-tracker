# Dependencies (reinstalled with `npm install`, never committed)
node_modules/

# Secrets – real keys live only in .env files (ground rule 1)
.env
.env.*
!.env.example

# Firebase / Google service account keys are SECRET (they let a server send pushes
# as you). Upload them to EAS, never commit them. google-services.json is NOT secret
# (it only identifies the app) and EAS Build needs it in the repo.
*service-account*.json
*-firebase-adminsdk-*.json

# Build output
dist/
build/

# Expo / React Native generated files
.expo/
web-build/
ios/
android/

# Logs and OS clutter
*.log
.DS_Store
